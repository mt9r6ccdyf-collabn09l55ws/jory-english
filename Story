<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>Jory English 🎀</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:6px;">
      <a href="javascript:history.back()" class="back-btn" aria-label="back">↩</a>
      <div class="brand" style="font-size:18px;" id="storyBrand">🎀</div>
    </div>
    <div class="topbar-actions">
      <button class="pill-btn" id="langToggle">🌐 <span class="lbl">EN</span></button>
      <button class="pill-btn" id="themeToggle">🌓 <span class="switch"></span></button>
    </div>
  </div>

  <div id="app">
    <div class="player-wrap">
      <h2 id="storyTitle" style="text-align:center;color:var(--pink-deep);"></h2>

      <div class="progress-row">
        <div class="bar-track" style="flex:1;"><div class="bar-fill" id="lineBarFill" style="width:0%"></div></div>
        <div class="sentence-count" id="sentenceCount"></div>
      </div>

      <div class="audio-row">
        <button class="round-btn" id="playBtn" title="play" aria-label="play">🔊</button>
        <button class="round-btn" id="replayBtn" title="replay" aria-label="replay">🔁</button>
        <button class="phonics-chip" id="phonicsBtn">🔤 <span class="ltr">IPA</span></button>
      </div>

      <div class="word-translate-card" id="wordCard"></div>

      <div class="type-box" id="typeBox">
        <div class="ghost-layer" id="ghostLayer"></div>
        <textarea class="type-input ltr" id="typeInput" rows="2" autocapitalize="off" autocomplete="off" spellcheck="false" data-i18n-placeholder="typePlaceholder"></textarea>
      </div>

      <div class="sentence-ar" id="sentenceAr"></div>
      <div class="success-banner" id="successBanner"></div>

      <div class="nav-row">
        <button class="next-btn" id="nextBtn" disabled data-i18n="next"></button>
      </div>
    </div>
  </div>

  <script src="js/storiesData.js"></script>
  <script src="js/app.js"></script>
  <script src="js/story.js"></script>
</body>
</html>
