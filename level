<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>Jory English 🎀</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:6px;">
      <a href="index.html" class="back-btn" aria-label="back">↩</a>
      <div class="brand" style="font-size:18px;" id="levelBrand">🎀</div>
    </div>
    <div class="topbar-actions">
      <button class="pill-btn" id="langToggle">🌐 <span class="lbl">EN</span></button>
      <button class="pill-btn" id="themeToggle">🌓 <span class="switch"></span></button>
    </div>
  </div>

  <div class="hero">
    <h1 id="levelTitle"></h1>
    <div class="lv-progress-label" id="levelProgressLabel" style="margin-top:10px;"></div>
    <div class="bar-track" style="max-width:320px;margin:6px auto 0;"><div class="bar-fill" id="levelBar" style="width:0%"></div></div>
  </div>

  <div class="story-path" id="storyPath"></div>

  <script src="js/storiesData.js"></script>
  <script src="js/app.js"></script>
  <script>
    const params = new URLSearchParams(location.search);
    const levelKey = ["A1","A2","B1","B2"].includes(params.get("level")) ? params.get("level") : "A1";

    function render() {
      const meta = JORY_DATA.levels[levelKey];
      const stories = JORY_DATA[levelKey];
      const done = Jory.countCompletedInLevel(levelKey);
      document.getElementById("levelBrand").textContent = meta.icon + " " + meta.label;
      document.getElementById("levelTitle").textContent = meta.icon + " " + meta.label;
      document.getElementById("levelProgressLabel").textContent = Jory.t("storiesDone", done, stories.length);
      document.getElementById("levelBar").style.width = (done / stories.length) * 100 + "%";

      const path = document.getElementById("storyPath");
      path.innerHTML = "";
      stories.forEach((s, idx) => {
        const isDone = Jory.isStoryComplete(s.id);
        const locked = s.comingSoon;
        const el = document.createElement(locked ? "div" : "a");
        if (!locked) el.href = `story.html?id=${s.id}`;
        el.className = "story-bubble" + (isDone ? " done" : "") + (locked ? " locked" : "");
        el.innerHTML = `
          <div class="sb-icon">${s.icon}</div>
          <div class="sb-text">
            <div class="sb-title">${idx + 1}. ${s.title}</div>
            <div class="sb-title-ar">${s.titleAr}</div>
            <div class="sb-meta">${locked ? Jory.t("comingSoon") : (s.totalWords + " " + (Jory.lang === "ar" ? "كلمة" : "words"))}</div>
          </div>
          ${isDone ? '<div class="sb-check">✅</div>' : locked ? '<div class="sb-lock">🔒</div>' : ""}
        `;
        path.appendChild(el);
      });
    }
    Jory.initTopbar();
    render();
    document.addEventListener("jory:langchange", render);
  </script>
</body>
</html>
